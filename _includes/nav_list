{% assign locale = include.locale | default: site.locale %}
<nav class="nav__list">
  {% if page.sidebar.title %}<h3 class="nav__title" style="padding-left: 0;">{{ page.sidebar.title }}</h3>{% endif %}
  <input id="ac-toc" name="accordion-toc" type="checkbox" />
  <label for="ac-toc">{{ site.data.ui-text[locale].menu_label | default: "Toggle Menu" }}</label>
  <ul class="nav__items">
  {% for navname in include.nav %}
    {% if navname == "design_patterns" %}
      {% comment %} Auto-generated from the _design_patterns collection. Never hand-edited. {% endcomment %}
      <li>
        <a href="{{ '/' | relative_url }}"><span class="nav__sub-title">Learning Map</span></a>
      </li>
      {% assign ordered = site.design_patterns | sort: "order" %}
      {% assign current_module = "" %}
      {% for d in ordered %}
        {% if d.module != current_module %}
          {% unless forloop.first %}</ul></li>{% endunless %}
          {% assign current_module = d.module %}
          <li><span class="nav__sub-title">{{ d.module }} &middot; {{ d.module_title }}</span><ul>
        {% endif %}
        <li><a href="{{ d.url | relative_url }}"{% if d.url == page.url %} class="active"{% endif %}>{{ d.title }}</a></li>
        {% if forloop.last %}</ul></li>{% endif %}
      {% endfor %}
      <li>
        <a href="{{ '/design_patterns/confusing-pairs/' | relative_url }}"><span class="nav__sub-title">Confusing Pairs</span></a>
      </li>
    {% else %}
      {% assign navigation = site.data.navigation[navname] %}
      {% for nav in navigation %}
        <li>
          {% if nav.url %}
            <a href="{{ nav.url | relative_url }}"><span class="nav__sub-title">{{ nav.title }}</span></a>
          {% else %}
            <span class="nav__sub-title">{{ nav.title }}</span>
          {% endif %}
          {% if nav.children != null %}
          <ul>
            {% for child in nav.children %}
              <li><a href="{{ child.url | relative_url }}"{% if child.url == page.url %} class="active"{% endif %}>{{ child.title }}</a></li>
            {% endfor %}
          </ul>
          {% endif %}
        </li>
      {% endfor %}
    {% endif %}
  {% endfor %}
  </ul>
</nav>
